generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  DESIGNER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  RUNNING
  PAUSED
  COMPLETED
}

enum FeedbackType {
  PROBLEM
  OPERATIONAL
  IDEA
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

enum GoalType {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(DESIGNER)
  jobTitle     String   @default("مصمم")
  isActive     Boolean  @default(true)
  isSystemUser Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasksCreated   Task[]          @relation("TaskCreator")
  tasksAssigned  Task[]          @relation("TaskAssignee")
  timeLogs       TaskTimeLog[]
  comments       TaskComment[]
  feedback       Feedback[]
  goals          Goal[]
  calendarEvents CalendarEvent[]
}

// المهام الفرعية = Task بـ parentId (قرار موثّق في HANDOFF: الفرعية لها تايمر وتعليقات ومسؤول).
model Task {
  id           String       @id @default(cuid())
  parentId     String?
  title        String
  description  String?
  attachments  Json         @default("[]")
  target       Int          @default(1)
  current      Int          @default(0)
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(NOT_STARTED)
  date         String       @db.VarChar(10)
  sortOrder    Int          @default(0)
  startedAt    DateTime?
  endTime      DateTime?
  createdById  String
  assignedToId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  parent     Task?         @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Task[]        @relation("TaskTree")
  createdBy  User          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  timeLogs   TaskTimeLog[]
  comments   TaskComment[]

  @@index([date])
  @@index([assignedToId, date])
  @@index([parentId])
}

model TaskTimeLog {
  id         String    @id @default(cuid())
  taskId     String
  userId     String
  startTime  DateTime
  stopTime   DateTime?
  stopReason String?
  createdAt  DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId])
}

model Feedback {
  id          String         @id @default(cuid())
  title       String
  description String
  attachments Json           @default("[]")
  type        FeedbackType
  status      FeedbackStatus @default(OPEN)
  date        String         @db.VarChar(10)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        GoalType
  target      Int        @default(1)
  current     Int        @default(0)
  startDate   String     @db.VarChar(10)
  endDate     String     @db.VarChar(10)
  status      GoalStatus @default(NOT_STARTED)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   String   @db.VarChar(10)
  endDate     String   @db.VarChar(10)
  color       String   @default("#6b8e7f")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

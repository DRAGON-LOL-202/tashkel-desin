generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  DESIGNER
  PACKER
  OPERATOR
  SALES_FLAGGER
  SALES_EDITOR
  SALES_SUPERVISOR
}

// وصول المستخدم للمخزون (يخص المصمم؛ الإدارة كاملة دائماً، وتعبئة/مشغل سحب فقط بتصنيفات محددة)
enum InventoryAccess {
  NONE
  WITHDRAW
  FULL
}

// لوحة المهام: التصميم (الافتراضية) أو الإنتاج
enum TaskBoard {
  DESIGN
  PRODUCTION
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  RUNNING
  PAUSED
  COMPLETED
}

// حالة المؤقت التنازلي لمهمة. PENDING = مُحدَّد المدة ولم يبدأ، EXPIRED = انتهى وقته (يضبطها المراقب أو أي إجراء لاحق).
enum TimerStatus {
  PENDING
  RUNNING
  PAUSED
  EXPIRED
}

enum FeedbackType {
  PROBLEM
  OPERATIONAL
  IDEA
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

enum GoalType {
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         Role     @default(DESIGNER)
  inventoryAccess InventoryAccess @default(NONE)
  // يظهر له كرت في لوحة المهام؟ (يحدده المدير؛ الموجودون وقت الإضافة = true)
  showTaskCard    Boolean         @default(true)
  // يظهر له كرت في لوحة «مهام الإنتاج»؟ (الافتراضي false)
  showProductionCard Boolean      @default(false)
  jobTitle     String   @default("مصمم")
  isActive     Boolean  @default(true)
  isSystemUser Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasksCreated   Task[]          @relation("TaskCreator")
  tasksAssigned  Task[]          @relation("TaskAssignee")
  timeLogs       TaskTimeLog[]
  comments       TaskComment[]
  feedback       Feedback[]
  goals          Goal[]
  calendarEvents CalendarEvent[]
  products       Product[]
  attendance     AttendanceSession[]

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsCaused   Notification[] @relation("NotificationActor")
  pushSubscriptions     PushSubscription[]
  inventoryMovements    InventoryMovement[]
  inventoryGroups       UserInventoryGroup[]
  salesOrders           SalesOrder[]
}

// المهام الفرعية = Task بـ parentId (قرار موثّق في HANDOFF: الفرعية لها تايمر وتعليقات ومسؤول).
model Task {
  id           String       @id @default(cuid())
  parentId     String?
  title        String
  description  String?
  attachments  Json         @default("[]")
  target       Int          @default(1)
  current      Int          @default(0)
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(NOT_STARTED)
  date         String       @db.VarChar(10)
  board        TaskBoard    @default(DESIGN)
  sortOrder    Int          @default(0)
  startedAt    DateTime?
  endTime      DateTime?
  createdById  String
  assignedToId String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  parent     Task?         @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Task[]        @relation("TaskTree")
  createdBy  User          @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User          @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  timeLogs   TaskTimeLog[]
  comments   TaskComment[]
  notifications Notification[]
  timer      TaskTimer?

  @@index([date])
  @@index([assignedToId, date])
  @@index([parentId])
  @@index([board, date])
}

model TaskTimeLog {
  id         String    @id @default(cuid())
  taskId     String
  userId     String
  startTime  DateTime
  stopTime   DateTime?
  stopReason String?
  createdAt  DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([taskId])
}

model Feedback {
  id          String         @id @default(cuid())
  title       String
  description String
  attachments Json           @default("[]")
  type        FeedbackType
  status      FeedbackStatus @default(OPEN)
  date        String         @db.VarChar(10)
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        GoalType
  target      Int        @default(1)
  current     Int        @default(0)
  startDate   String     @db.VarChar(10)
  endDate     String     @db.VarChar(10)
  status      GoalStatus @default(NOT_STARTED)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   String   @db.VarChar(10)
  endDate     String   @db.VarChar(10)
  color       String   @default("#6b8e7f")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  categoryId  String
  // صورة المنتج الأساسية (عنصر واحد كحد أقصى) بنفس شكل مرفقات المهام والملاحظات
  attachments Json     @default("[]")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category  ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  variants  ProductVariant[]

  @@index([categoryId])
}

// خامة/نسخة من المنتج: لكل خامة تكلفة (خامة + وقت ماكينة) وسعر بيع
// cost = materialCost + machineCost (يحسبه الـ backend ويُخزَّن للتوافق مع أي استعلام قديم)
model ProductVariant {
  id           String  @id @default(cuid())
  productId    String
  label        String  @default("")
  cost         Decimal @db.Decimal(12, 2)
  materialCost Decimal @default(0) @db.Decimal(12, 2)
  machineCost  Decimal @default(0) @db.Decimal(12, 2)
  price        Decimal @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// جلسة حضور: تبدأ بزر حضور/عودة وتنتهي بزر انصراف. المستخدم قد يملك عدة جلسات في اليوم (حضور ثم عودة)،
// وتُنسب الجلسة كلها ليوم بدايتها (workDate بتوقيت ATTENDANCE_TZ) حتى لو عبرت منتصف الليل.
// endTime = null تعني أن الجلسة مفتوحة (لم يُسجَّل انصراف). مفتوحة واحدة كحد أقصى لكل مستخدم (يضمنها الـ route بقفل صف المستخدم).
model AttendanceSession {
  id        String    @id @default(cuid())
  userId    String
  workDate  String    @db.VarChar(10)
  startTime DateTime
  endTime   DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, workDate])
  @@index([workDate])
}

// إشعار داخل الموقع لمستلم واحد. type = نوع الحدث (انظر utils/notify.ts)، category = tasks | reminders | comments | admin.
// حذف المستلم يحذف إشعاراته؛ حذف من تسبب بالإشعار أو المهمة يُبقي الإشعار بدون ربط.
model Notification {
  id               String    @id @default(cuid())
  recipientId      String
  actorId          String?
  type             String
  category         String
  title            String
  message          String
  relatedTaskId    String?
  relatedSubtaskId String?
  isRead           Boolean   @default(false)
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  task      Task? @relation(fields: [relatedTaskId], references: [id], onDelete: SetNull)

  @@index([recipientId, isRead, createdAt])
  @@index([recipientId, createdAt])
  @@index([relatedTaskId])
}

// مؤقت تنازلي لمهمة (واحد كحد أقصى). remainingMs = المتبقي عند آخر نقطة حفظ (بدء/إيقاف/تمديد)،
// والمتبقي الفعلي أثناء العمل = remainingMs - (الآن - runningSince). لا نخزّن العدّ نفسه.
// warned10/warned1/expiredNotified تمنع تكرار التنبيه (تُصفَّر عند التمديد).
model TaskTimer {
  id              String      @id @default(cuid())
  taskId          String      @unique
  plannedMs       Int
  remainingMs     Int
  status          TimerStatus @default(PENDING)
  runningSince    DateTime?
  warned10        Boolean     @default(false)
  warned1         Boolean     @default(false)
  expiredNotified Boolean     @default(false)
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([status])
}

// اشتراك جهاز/متصفح في Web Push. endpoint فريد عالمياً: إن سجّل مستخدم آخر الدخول على نفس الجهاز
// يُنقل الاشتراك إليه (upsert) فلا يصل إشعار المستخدم السابق لهذا الجهاز.
model PushSubscription {
  id          String    @id @default(cuid())
  userId      String
  endpoint    String    @unique
  p256dh      String
  auth        String
  userAgent   String?
  createdAt   DateTime  @default(now())
  lastPushAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== المخزون =====
// IN = إدخال (وارد / رصيد افتتاحي)، OUT = إخراج (سحب)، ADJUST = جرد (تسوية الرصيد)، RETURN = مرتجع إلى المخزون
enum InventoryMovementType {
  IN
  OUT
  ADJUST
  RETURN
}

// مجموعة رئيسية ثابتة للتصنيفات (خامات | اكسسوارات وهدايا). لا تُنشأ من الواجهة؛ تُبذر في migration 0013.
model InventoryGroup {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  categories   InventoryCategory[]
  allowedUsers UserInventoryGroup[]
}

// تصنيف عناصر المخزون المستقل. لا يُحذف تصنيف عليه عناصر إلا بعد نقلها لتصنيف آخر.
// groupId فارغ للتصنيفات القديمة فقط (لا يصل إليها تعبئة/مشغل حتى يوزّعها المدير).
model InventoryCategory {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  groupId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group InventoryGroup? @relation(fields: [groupId], references: [id], onDelete: Restrict)
  items InventoryItem[]

  @@index([groupId])
}

// المجموعات الرئيسية المسموح لمستخدم (تعبئة/مشغل) السحب من كل تصنيفاتها. حذف المستخدم أو المجموعة ينظّف الصفوف تلقائياً.
model UserInventoryGroup {
  userId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  group InventoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

// عنصر مخزون مستقل تماماً عن صفحة أسعار المنتجات. الرصيد quantity والسعر unitPrice لا يهبطان تحت الصفر.
model InventoryItem {
  id           String   @id @default(cuid())
  name         String
  categoryId   String
  // صور العنصر (حتى 10) بنفس شكل مرفقات المهام والمنتجات
  attachments  Json     @default("[]")
  sku          String?  @unique
  unit         String   @default("قطعة")
  quantity     Decimal  @default(0) @db.Decimal(14, 3)
  minQuantity  Decimal  @default(0) @db.Decimal(14, 3)
  unitPrice    Decimal  @default(0) @db.Decimal(14, 2)
  // سعر البيع (جنيه مصري) — منفصل عن سعر الوحدة (التكلفة) ولا يدخل في حساب قيمة المخزون
  sellPrice    Decimal  @default(0) @db.Decimal(14, 2)
  lowAlertSent Boolean  @default(false)
  notes        String   @default("")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category  InventoryCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements InventoryMovement[]
  salesProductComponents SalesProductComponent[]
  salesOrderComponents   SalesOrderComponent[]

  @@index([categoryId])
  @@index([isActive])
}

// حركة مخزون غير قابلة للتعديل (سجل تدقيق). delta موقّعة (+ إدخال/مرتجع / - إخراج / ± فرق جرد).
model InventoryMovement {
  id                String                @id @default(cuid())
  itemId            String
  type              InventoryMovementType
  previousBalance   Decimal               @default(0) @db.Decimal(14, 3)
  delta             Decimal               @db.Decimal(14, 3)
  balanceAfter      Decimal               @db.Decimal(14, 3)
  unitPriceSnapshot Decimal               @default(0) @db.Decimal(14, 2)
  reason            String                @default("")
  referenceId       String?
  note              String                @default("")
  // معرّف عملية السحب (عدة أصناف في طلب واحد). null لحركات الإدخال/الجرد/المرتجع/الإخراج الفردي.
  batchId           String?
  createdById       String
  createdAt         DateTime              @default(now())

  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
  @@index([batchId])
  @@index([type, createdAt])
}

// ===== المبيعات العامة =====
// حالة الأوردر: التنفيذ/الشحن/التسليم تخصم مكوناته من المخزون (مرة واحدة)، والعودة لـ «مسجل» أو «مرتجع» تعيدها.
enum SalesOrderStatus {
  REGISTERED
  EXECUTED
  SHIPPED
  DELIVERED
  RETURNED
}

// منتج مبيعات ثابت (مثل «بوكس كبير») له محتويات من المخزون تُنسخ إلى الأوردر عند إضافته.
model SalesProduct {
  id        String   @id @default(cuid())
  name      String
  notes     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components SalesProductComponent[]
  orderLines SalesOrderLine[]

  @@index([isActive])
}

model SalesProductComponent {
  id        String  @id @default(cuid())
  productId String
  itemId    String
  quantity  Decimal @db.Decimal(14, 3)

  product SalesProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([productId, itemId])
  @@index([itemId])
}

model SalesOrder {
  id            String           @id @default(cuid())
  // يوم الأوردر (YYYY-MM-DD) مثل تاريخ المهام
  date          String           @db.VarChar(10)
  // رقم البوليصة (يدخله المستخدم)
  waybill       String           @default("")
  // اسم المقفل (من أغلق الأوردر)
  closerName    String           @default("")
  status        SalesOrderStatus @default(REGISTERED)
  // هل خُصمت المكونات من المخزون فعلاً؟ يمنع الخصم المزدوج
  stockDeducted Boolean          @default(false)
  // علامة «مرتجع» من الشركة: الموظف يراجع الأوردر ثم يسجله مرتجعاً (لا تمس المخزون؛ تُمسح عند التحويل إلى مرتجع)
  returnFlagged   Boolean        @default(false)
  returnFlaggedAt DateTime?
  notes         String           @default("")
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  createdBy User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  lines     SalesOrderLine[]

  @@index([date])
  @@index([status])
  @@index([waybill])
}

model SalesOrderLine {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?
  // اسم المنتج وقت الإضافة (يبقى حتى لو حُذف المنتج الثابت)
  productName String
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  order      SalesOrder             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    SalesProduct?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  components SalesOrderComponent[]

  @@index([orderId])
}

// محتويات البند منسوخة من المنتج الثابت (كمية الوحدة الواحدة). السعران يُثبَّتان لحظة التنفيذ.
model SalesOrderComponent {
  id                String   @id @default(cuid())
  lineId            String
  itemId            String
  quantity          Decimal  @db.Decimal(14, 3)
  unitCostSnapshot  Decimal? @db.Decimal(14, 2)
  unitSellSnapshot  Decimal? @db.Decimal(14, 2)
  // تالف عند المرتجع: لا يعود للمخزون ويُحسب في إجمالي التالف لليوم
  damaged           Boolean  @default(false)

  line SalesOrderLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  item InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([lineId])
  @@index([itemId])
}

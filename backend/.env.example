# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/tashkeel_desin
DB_POOL_MAX=10
# DATABASE_CA_CERT=

# Auth & Server
JWT_SECRET=replace-with-a-random-secret-at-least-16-chars
PORT=4000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Seeded Admin Account (used by `npm run seed`)
ADMIN_USERNAME=lol
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_EMAIL=admin@example.com

# Attendance / Date Rollover Timezone (IANA) & Strict Task Range
ATTENDANCE_TZ=Africa/Cairo
# TASKS_REQUIRE_RANGE=true

# Optional Timer Watchdog Cron Endpoint (`/api/internal/tick`)
# CRON_SECRET=replace-with-a-random-secret-at-least-16-chars

# Optional Cloudflare R2 Attachment Storage (set all 4 together or leave unset)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=
R2_MAX_FILE_MB=10

# Optional Web Push (VAPID) Notifications (set all 3 together or leave unset)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
